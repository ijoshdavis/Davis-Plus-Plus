# Client-side Supabase config - the anon/publishable key, safe for the
# browser bundle (RLS is what actually protects data, not key secrecy).
# Get these from Supabase Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: your Ancestry.com tree's numeric id, from its own URL
# (ancestry.com/family-tree/tree/<this number>/family) - not the tree's
# display name, which is all person_external_id/persona store. Used to
# build "Open in Ancestry" links in the graph view's node tooltip.
NEXT_PUBLIC_ANCESTRY_TREE_ID=your-tree-id

# Both URLs route through Supavisor (the pooler host), never
# db.PROJECT_REF.supabase.co directly - see docs/decisions.md for why.

# Session-mode pooler (5432) - migrations, admin scripts, ingest/batch jobs.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Transaction-mode pooler (6543) - for the Vercel app runtime (api/, web/).
POOLED_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
